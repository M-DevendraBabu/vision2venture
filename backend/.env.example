DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=NewPassword123
DB_NAME=vision2venture_db
SECRET_KEY=your-secure-random-32-byte-hex-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
GEMINI_API_KEY=your-api-key-here

# ── Offline competitor discovery: commercial POI providers ──────────────────
# Both are FREE with NO credit card required. With neither key set, the app
# still works normally using OpenStreetMap/Overpass alone.
#
# HERE Discover API — ~30,000 requests/month free.
#   Sign up at https://platform.here.com -> create a project -> REST API key
HERE_API_KEY=
#
# TomTom Search API — ~2,500 requests/month free.
#   Sign up at https://developer.tomtom.com -> Dashboard -> add a new App/Key
TOMTOM_API_KEY=

# ── Real competitor ratings & reviews ───────────────────────────────────────
# HERE, TomTom and OpenStreetMap return business LOCATIONS but no ratings.
# These are the only sources of real customer ratings and review text.
# With neither key set, competitor ratings are reported as unavailable — the
# app never estimates, defaults or generates a rating.
#
# Google Places API (New) — best coverage in India. Returns the real star
#   rating, real total rating count and up to 5 real review texts.
#   Setup: console.cloud.google.com -> new project -> enable "Places API (New)"
#   -> create an API key. Billing must be enabled; Places includes a monthly
#   free allowance, so light use typically costs nothing. Restrict the key.
GOOGLE_PLACES_API_KEY=
#
# Foursquare Places API — fallback. Real 0-10 rating (rescaled to 0-5 here)
#   plus user "tips" as review text. Free developer tier.
#   Setup: foursquare.com/developers -> create a project -> Service API key.
FOURSQUARE_API_KEY=
