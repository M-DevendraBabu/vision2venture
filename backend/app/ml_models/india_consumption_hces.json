{
  "_meta": {
    "description": "Real per-capita consumption from the Government of India's Household Consumption Expenditure Survey, used to size local (offline and hybrid) catchment markets. Replaces six per_capita_spend numbers that were hardcoded in ml_service.py with no source, every one of which overstated the real figure.",
    "source": "MoSPI / National Statistics Office, Household Consumption Expenditure Survey 2023-24 Fact Sheet (fieldwork August 2023 - July 2024; 2,61,953 households; 1,54,357 rural and 1,07,596 urban)",
    "source_url": "https://www.mospi.gov.in/sites/default/files/publication_reports/HCES%20FactSheet%202023-24.pdf",
    "as_of": "2023-24",
    "tables_used": "Statement 4 (item-group break-up of MPCE), Statements 5 and 6 (percentage composition, for lines not broken out in Statement 4), Statement 7 (MPCE by State/UT)",
    "all_india_mpce_monthly": {
      "rural": 4122,
      "urban": 6996
    },
    "method": "annual_per_capita = HCES monthly figure x 12 x share. Shares are 1.0 wherever an HCES item group maps directly onto the business; the two cases that need a share carry a SHARE ASSUMPTION note in their basis field.",
    "state_scaling": "state_multiplier = state MPCE / all-India MPCE, applied to the all-India figure so a catchment in Andhra Pradesh is not sized with Bihar's spending power.",
    "caveat": "These are population averages. A venture serving a self-selecting, higher-spending segment may address more per customer than the average - but the catchment TOTAL is what this sizes, and that total is bounded by what the population actually spends.",
    "city_to_state": "Maps a city named in the user's location to its state, so the state MPCE multiplier can be applied. A location naming a state directly is matched against state_mpce_monthly first."
  },
  "categories": {
    "food_restaurant": {
      "match": [
        "food",
        "beverage",
        "cafe",
        "restaurant",
        "biryani",
        "bakery",
        "dining",
        "tiffin",
        "canteen",
        "cloud kitchen",
        "juice",
        "tea stall"
      ],
      "hces_line": "beverages, refreshments, processed food",
      "monthly_per_capita": {
        "rural": 406,
        "urban": 776
      },
      "share_of_hces_line": 1.0,
      "annual_per_capita": {
        "rural": 4872,
        "urban": 9312
      },
      "basis": "This HCES line explicitly includes purchased cooked meals and snacks, which is exactly what an eating-out business competes for. The previous hardcoded Rs 22,000/year was close to a household's ENTIRE annual food budget (Rs 23,268 rural / Rs 33,312 urban), most of which is groceries cooked at home and not addressable by a restaurant."
    },
    "grocery_retail": {
      "match": [
        "comm",
        "d2c",
        "marketplace",
        "retail",
        "grocery",
        "supermarket",
        "organic",
        "store",
        "hyperlocal",
        "kirana",
        "provision"
      ],
      "hces_line": "food total minus beverages/processed food (i.e. at-home groceries)",
      "monthly_per_capita": {
        "rural": 1533,
        "urban": 2000
      },
      "share_of_hces_line": 1.0,
      "annual_per_capita": {
        "rural": 18396,
        "urban": 24000
      },
      "basis": "Total food spend less the eating-out line, since a grocery retailer addresses what households cook at home."
    },
    "gym_fitness": {
      "match": [
        "gym",
        "fitness",
        "crossfit",
        "workout",
        "wellness",
        "yoga",
        "zumba"
      ],
      "hces_line": "entertainment (includes club, gym, swimming fees & other subscriptions)",
      "monthly_per_capita": {
        "rural": 42,
        "urban": 124
      },
      "share_of_hces_line": 1.0,
      "annual_per_capita": {
        "rural": 504,
        "urban": 1488
      },
      "basis": "HCES has no gym line; gym and club subscriptions sit inside 'entertainment', which is 1.02% of rural and 1.77% of urban MPCE (Statements 5 and 6). This whole category also carries cinema, cable/DTH and streaming, so a gym addresses only part of it - the figure here is already the generous reading. The previous Rs 9,500/year assumed more than six times the entire entertainment budget."
    },
    "health_clinic": {
      "match": [
        "health",
        "clinic",
        "doctor",
        "medical",
        "dental",
        "diagnos",
        "pharmacy",
        "physio"
      ],
      "hces_line": "medical (hospitalisation and non-hospitalisation)",
      "monthly_per_capita": {
        "rural": 282,
        "urban": 409
      },
      "share_of_hces_line": 1.0,
      "annual_per_capita": {
        "rural": 3384,
        "urban": 4908
      },
      "basis": "Covers medicine, consultation, tests and hospital charges."
    },
    "education_coaching": {
      "match": [
        "edu",
        "school",
        "college",
        "coaching",
        "learn",
        "tutor",
        "training",
        "skill"
      ],
      "hces_line": "education",
      "monthly_per_capita": {
        "rural": 133,
        "urban": 418
      },
      "share_of_hces_line": 1.0,
      "annual_per_capita": {
        "rural": 1596,
        "urban": 5016
      },
      "basis": "Tuition and other fees, private tutor/coaching, books and stationery. Note the 3.1x rural-urban gap: rural households spend Rs 133/month on education against Rs 418 in urban India."
    },
    "salon_beauty": {
      "match": [
        "salon",
        "spa",
        "beauty",
        "grooming",
        "parlour",
        "barber"
      ],
      "hces_line": "consumer services excluding conveyance (barber, beautician, spa share)",
      "monthly_per_capita": {
        "rural": 217,
        "urban": 400
      },
      "share_of_hces_line": 0.25,
      "annual_per_capita": {
        "rural": 651,
        "urban": 1200
      },
      "basis": "SHARE ASSUMPTION: 'barber, beautician, spas' is one line among roughly eighteen inside this HCES group (which also holds telephone, domestic help, tailoring, laundry and repairs). A 25% share is a planning assumption, not a published split - it is the only estimated number in this file."
    },
    "_default": {
      "match": [],
      "hces_line": "all items (total MPCE)",
      "monthly_per_capita": {
        "rural": 4122,
        "urban": 6996
      },
      "share_of_hces_line": 0.08,
      "annual_per_capita": {
        "rural": 3957,
        "urban": 6716
      },
      "basis": "SHARE ASSUMPTION: for a sector with no matching HCES line, 8% of total household spend is taken as addressable. A planning assumption."
    }
  },
